{
  "name": "nyvel-e2e",
  "private": true,
  "description": "End-to-end tests for the Nyvel app (Playwright + TypeScript), run against a throwaway local Supabase.",
  "scripts": {
    "db:start": "supabase start -x studio,imgproxy,storage-api,realtime,edge-runtime,logflare,vector,supavisor,mailpit,postgres-meta",
    "db:stop": "supabase stop --no-backup",
    "db:schema": "bash scripts/apply-schema.sh",
    "app:build": "bash scripts/build-app.sh",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@supabase/supabase-js": "^2.112.4",
    "@types/node": "^22.0.0",
    "serve": "^14.2.4",
    "supabase": "2.118.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
